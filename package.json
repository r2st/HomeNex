{
  "name": "homenex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port ${PORT:-5173}",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "npm run test:ui && npm run test:server",
    "test:ui": "node --test --import ./src/test/register.mjs 'src/**/*.test.js' 'src/**/*.test.jsx'",
    "test:ui:coverage": "node --test --import ./src/test/register.mjs --experimental-test-coverage 'src/**/*.test.js' 'src/**/*.test.jsx'",
    "test:db:clean": "node server/scripts/dropStaleTestDbs.js",
    "pretest:server": "npm run test:db:clean",
    "test:server": "node --test --test-concurrency=4 'server/test/*.test.js'",
    "pretest:coverage": "npm run test:db:clean",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=4 'server/test/*.test.js'",
    "dev:admin": "vite --config admin/vite.config.js --port ${ADMIN_PORT:-5174}",
    "build:admin": "vite build --config admin/vite.config.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
