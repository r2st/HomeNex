# HomeNex backend configuration
# Copy to .env and fill in real values.

PORT=8787

# PostgreSQL connection. For local dev, `docker compose up -d` (repo root) provides
# this exact database. Migrations in server/migrations/ run automatically on startup.
DATABASE_URL=postgres://homenex:homenex@localhost:5432/homenex

# Meta WhatsApp Business API (from developers.facebook.com > your app > WhatsApp)
WHATSAPP_VERIFY_TOKEN=homenex-verify
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Default/fallback phone_number_id. Each agent can configure their own WhatsApp Business
# number via the dashboard; this value is used when an agent hasn't set one up yet.
WHATSAPP_PHONE_NUMBER_ID=

# OpenRouter (free models) — https://openrouter.ai/keys
# Default model is a plain instruct model that stays in English/Hindi/Hinglish.
# Avoid small reasoning models like openai/gpt-oss-20b:free here — they leak stray
# CJK/Korean tokens into buyer-facing replies.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Production ---------------------------------------------------------------
# SESSION_SECRET is FATAL in production: the server refuses to start without it.
# Everything else below has a working default and is only worth setting deliberately.

# Signs session tokens. Unset, the secret is regenerated on every restart, which logs
# every agent out on each deploy; a short one can be brute-forced into a forged
# session. At least 16 characters — `openssl rand -hex 32`.
SESSION_SECRET=

# Public origin of this server, used to build absolute links to uploaded media.
# WhatsApp fetches those URLs itself, so a relative link is a broken attachment.
# Warned about (not fatal) in production.
PUBLIC_BASE_URL=https://homenex.aiknol.com

# CORS. Off by default, which is correct while the dashboard is served same-origin by
# this same process — the browser's same-origin policy then stays maximally strict.
# Set only if the frontend moves to another host: a comma-separated allowlist, or `*`
# (which also drops Allow-Credentials, since the two cannot be combined).
# CORS_ORIGIN=https://app.example.com

# HSTS max-age in seconds, sent only on requests that arrived over TLS. Defaults to
# 31536000 (a year). Set 0 to disable — worth doing on a host whose certificate story
# is not settled, because a browser that has seen this header refuses plain HTTP to
# the host until it expires and nothing the server sends can shorten that. Stage a
# short value (600) before committing to a year.
# HSTS_MAX_AGE=31536000

# Postgres pool size. Must be a positive number, or startup fails. The box shares its
# PostgreSQL with the other services on it, so this is the knob for that budget.
# PG_POOL_SIZE=10

# Rate limits, per minute. Auth defaults to 20/min per IP (blunts credential
# stuffing); uploads to 60/min, keyed by agent rather than IP because the cost lands
# per account and a whole office can share one NAT address. The public webhook/ingest
# ceiling is 240/min and is deliberately not configurable — it is sized to absorb a
# legitimate Meta burst rather than to be tuned.
# AUTH_RATE_LIMIT=20
# UPLOAD_RATE_LIMIT=60

# Access log. On by default outside NODE_ENV=test; set 0 to silence it.
# LOG_REQUESTS=1

# Dashboard counter cache (/api/stats), in milliseconds. That endpoint is polled every
# 8-10s per open screen and its counters run over the agent's whole lead history, so
# the result is held briefly instead of being recomputed on each poll. A new lead or a
# new message drops the agent's entry immediately, so those still land on the next
# poll. Set to 0 to disable. Defaults to 8000 (and to 0 under NODE_ENV=test).
STATS_CACHE_MS=8000
