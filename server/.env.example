# HomeNex backend configuration
# Copy to .env and fill in real values.

PORT=8787

# PostgreSQL connection. For local dev, `docker compose up -d` (repo root) provides
# this exact database. Migrations in server/migrations/ run automatically on startup.
DATABASE_URL=postgres://homenex:homenex@localhost:5432/homenex

# Meta WhatsApp Business API (from developers.facebook.com > your app > WhatsApp)
WHATSAPP_VERIFY_TOKEN=homenex-verify
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# Default/fallback phone_number_id. Each agent can configure their own WhatsApp Business
# number via the dashboard; this value is used when an agent hasn't set one up yet.
WHATSAPP_PHONE_NUMBER_ID=

# OpenRouter (free models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
